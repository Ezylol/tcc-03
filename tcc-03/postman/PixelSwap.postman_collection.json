{
  "info": {
    "name": "PixelSwap API",
    "description": "Collection for PixelSwap marketplace demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/pixelswap",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Lucas Pixel\",\n  \"email\": \"lucas@pixelswap.dev\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/index.php?route=auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "auth/register" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"lucas@pixelswap.dev\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/index.php?route=auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "auth/login" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Games",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/index.php?route=games",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "games" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Search Games",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/index.php?route=games&search=celeste",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "games" },
            { "key": "search", "value": "celeste" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Listing",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"game_id\": 2,\n  \"price\": 19.50,\n  \"listing_type\": \"sale\",\n  \"accepts_trade\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/index.php?route=listings",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "listings" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Edit Listing",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 17.99,\n  \"accepts_trade\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/index.php?route=listings/1",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "listings/1" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Simulate Purchase",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"listing_id\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/index.php?route=orders",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "orders" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Trade Proposal",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"offered_key_id\": 2,\n  \"requested_listing_id\": 1,\n  \"message\": \"Posso oferecer a chave de Celeste em troca.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/index.php?route=trades",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "trades" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Accept Trade",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/api/index.php?route=trades/1/accept",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "trades/1/accept" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Reject Trade",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/api/index.php?route=trades/1/reject",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "trades/1/reject" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Unauthorized Access",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/index.php?route=auth/me",
          "host": ["{{base_url}}"],
          "path": ["api", "index.php"],
          "query": [
            { "key": "route", "value": "auth/me" }
          ]
        }
      },
      "response": []
    }
  ]
}
